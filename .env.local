# Local environment variables for Shop.APIIdentity (do NOT commit secrets to remote)
# Adjust values if needed for your environment

# PostgreSQL connection used by the Identity API
ConnectionStrings__DefaultConnection="Host=localhost;Port=5432;Database=identity;Username=postgres;Password=postgres"

# RabbitMQ connection
RabbitMQ__Host="amqp://guest:guest@localhost:5672"

# JWT configuration - use a strong secret in production
Jwt__Key="change_this_to_a_long_secret_at_least_32_chars_123456"
Jwt__Issuer="shop.local"
Jwt__Audience="shop.local"

# ASP.NET Core settings
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://0.0.0.0:8080
