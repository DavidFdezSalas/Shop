{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "JwtSettings": {
    "Issuer": "TiendaDavid.Identity",
    "Audience": "TiendaDavid.API",
    "ExpiryInMinutes": 60
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "identity-api-route": {
        "ClusterId": "identity-api",
        "RateLimiterPolicy": "open",
        "Match": {
          "Path": "/api/v{version}/Auth/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "identity-api": {
        "LoadBalancingPolicy": "Random",
        "Destinations": {
          "identity-api/destination1": {
            "Address": "https://shop-apiidentity1"
          }
        }
      }
    }
  }
}
  