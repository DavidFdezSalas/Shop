{
  "info": {
    "name": "Shop API - Complete Collection",
    "description": "Colección completa de endpoints de autenticación, administración de usuarios y categorías",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://localhost:7049",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "customerToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "testUserId",
      "value": "",
      "type": "string"
    },
    {
      "key": "testUserEmail",
      "value": "testuser@example.com",
      "type": "string"
    },
    {
      "key": "testUserPassword",
      "value": "Test123!",
      "type": "string"
    },
    {
      "key": "testCategoryId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "1. Login Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set(\"adminToken\", jsonData.token);",
                  "    console.log(\"Admin token guardado: \" + jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@shop.com\",\n  \"password\": \"Admin123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/Auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "Auth", "login"]
            }
          }
        },
        {
          "name": "2. Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testuser\",\n  \"email\": \"{{testUserEmail}}\",\n  \"password\": \"{{testUserPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/Auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "Auth", "register"]
            }
          }
        },
        {
          "name": "3. Login Customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set(\"customerToken\", jsonData.token);",
                  "    console.log(\"Customer token guardado: \" + jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testUserEmail}}\",\n  \"password\": \"{{testUserPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/Auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "Auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "User Self-Service",
      "item": [
        {
          "name": "4. Get My Info",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/Users/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "Users", "me"]
            }
          }
        },
        {
          "name": "5. Update My Info",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userName\": \"testuser_updated\",\n  \"email\": \"{{testUserEmail}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/Users/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "Users", "me"]
            }
          }
        },
        {
          "name": "6. Delete My Account",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/Users/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "Users", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "Admin - User Management",
      "item": [
        {
          "name": "7. Get All Users",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/Admin/Users?pageNumber=1&pageSize=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "Admin", "Users"],
              "query": [
                {
                  "key": "pageNumber",
                  "value": "1"
                },
                {
                  "key": "pageSize",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "8. Get User By ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/Admin/Users/{{testUserId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "Admin", "Users", "{{testUserId}}"]
            }
          }
        },
        {
          "name": "9. Update User",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userName\": \"admin_updated_user\",\n  \"email\": \"{{testUserEmail}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/Admin/Users/{{testUserId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "Admin", "Users", "{{testUserId}}"]
            }
          }
        },
        {
          "name": "10. Delete User",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/Admin/Users/{{testUserId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "Admin", "Users", "{{testUserId}}"]
            }
          }
        },
        {
          "name": "11. Lock User",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/Admin/Users/{{testUserId}}/lock",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "Admin", "Users", "{{testUserId}}", "lock"]
            }
          }
        },
        {
          "name": "12. Unlock User",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/Admin/Users/{{testUserId}}/unlock",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "Admin", "Users", "{{testUserId}}", "unlock"]
            }
          }
        },
        {
          "name": "14. Assign Role",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roleName\": \"Admin\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/Admin/Users/{{testUserId}}/roles",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "Admin", "Users", "{{testUserId}}", "roles"]
            }
          }
        },
        {
          "name": "16. Get User Stats",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/Admin/Users/stats",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "Admin", "Users", "stats"]
            }
          }
        }
      ]
    },
    {
      "name": "Categories",
      "item": [
        {
          "name": "17. Get All Categories",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}",
                "description": "Requiere autenticación (Customer o Admin)"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/Categories",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "Categories"]
            }
          },
          "response": []
        },
        {
          "name": "18. Get Category By ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    console.log(\"Categoría encontrada: \" + jsonData.name);",
                  "    console.log(\"Productos asociados: \" + jsonData.productCount);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}",
                "description": "Requiere autenticación (Customer o Admin)"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/Categories/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "Categories", "1"]
            }
          },
          "response": []
        },
        {
          "name": "19. Create Category (Admin Only)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set(\"testCategoryId\", jsonData.id);",
                  "    console.log(\"Categoría creada con ID: \" + jsonData.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}",
                "description": "Solo Admin puede crear categorías"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Categoría de Prueba\",\n  \"description\": \"Esta es una categoría creada desde Postman para testing\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/Categories",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "Categories"]
            }
          },
          "response": []
        },
        {
          "name": "20. Create Category - Validation Error (Nombre corto)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"AB\",\n  \"description\": \"Esto fallará porque el nombre es muy corto\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/Categories",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "Categories"]
            }
          },
          "response": []
        },
        {
          "name": "21. Create Category - Validation Error (Nombre duplicado)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Electrónica\",\n  \"description\": \"Esto fallará porque ya existe esa categoría\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/Categories",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "Categories"]
            }
          },
          "response": []
        },
        {
          "name": "22. Update Category (Admin Only)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}",
                "description": "Solo Admin puede actualizar categorías"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Categoría Actualizada\",\n  \"description\": \"Descripción modificada desde Postman\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/Categories/{{testCategoryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "Categories", "{{testCategoryId}}"]
            }
          },
          "response": []
        },
        {
          "name": "23. Delete Category (Admin Only)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}",
                "description": "Solo Admin puede eliminar categorías"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/Categories/{{testCategoryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "Categories", "{{testCategoryId}}"]
            }
          },
          "response": []
        },
        {
          "name": "24. Delete Category - Has Products Error",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/Categories/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "Categories", "1"],
              "description": "Intenta eliminar categoría con ID=1 (Electrónica) que tiene productos asociados. Debería fallar."
            }
          },
          "response": []
        },
        {
          "name": "25. Customer Try Create Category (Forbidden)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}",
                "description": "Customer NO puede crear categorías"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Categoría prohibida\",\n  \"description\": \"Esto fallará con 403 Forbidden\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/Categories",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "Categories"]
            }
          },
          "response": []
        }
      ]
    }
  ]
}